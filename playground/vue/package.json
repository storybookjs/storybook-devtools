    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.57.0",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
