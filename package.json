{
  "name": "@storybook/experimental-devtools",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Dev-server devtools for visual component highlighting and automatic Storybook story generation.",
  "author": "Yann Braga <yannbf@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/storybookjs/vite-plugin-experimental-storybook-devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/vite-plugin-experimental-storybook-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/storybookjs/vite-plugin-experimental-storybook-devtools/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./devframe": {
      "types": "./dist/devframe-export.d.mts",
      "default": "./dist/devframe-export.mjs"
    },
    "./react": {
      "types": "./dist/frameworks/react/plugin.d.mts",
      "default": "./dist/frameworks/react/plugin.mjs"
    },
    "./vue": {
      "types": "./dist/frameworks/vue/plugin.d.mts",
      "default": "./dist/frameworks/vue/plugin.mjs"
    },
    "./nuxt": {
      "types": "./dist/frameworks/nuxt/plugin.d.mts",
      "default": "./dist/frameworks/nuxt/plugin.mjs"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.mts",
      "default": "./dist/rsbuild.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./package.json": "./package.json",
    "./client/overlay": "./dist/client/overlay.mjs",
    "./client/listeners": "./dist/client/listeners.mjs",
    "./client/vite-devtools": "./dist/client/vite-devtools.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm build:panel",
    "build:panel": "vite build --config vite.config.panel.ts",
    "dev": "trap 'kill 0' EXIT; tsdown --watch & vite build --watch --config vite.config.panel.ts & wait",
    "dev:panel": "vite build --watch --config vite.config.panel.ts",
    "play": "vite",
    "test": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.1.7",
    "@vitejs/devtools": ">=0.6.0",
    "next": ">=15.0.0",
    "storybook": ">=10.6.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@rsbuild/core": "^2.1.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.0.3",
    "@vitejs/devtools": "^0.6.0",
    "@vitejs/devtools-kit": "^0.6.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/compiler-sfc": "^3.5.28",
    "bumpp": "^10.3.2",
    "pkg-pr-new": "^0.0.75",
    "playwright": "^1.57.0",
    "storybook": "10.6.0",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@devframes/hub": "^0.9.5",
    "@devframes/hub-ui": "^0.9.5",
    "@devframes/next": "0.9.5",
    "@devframes/plugin-terminals": "0.9.5",
    "@devframes/service-open": "0.9.5",
    "@medv/finder": "^3.1.0",
    "@testing-library/dom": "^10.4.0",
    "devframe": "^0.9.12",
    "dom-accessibility-api": "^0.6.3",
    "nanoevents": "^9.0.0",
    "react-element-to-jsx-string": "^15.0.0",
    "unplugin": "^3.3.0",
    "unplugin-utils": "^0.3.2",
    "webpack-virtual-modules": "^0.6.2",
    "xstate": "^5.3.0"
  }
}
